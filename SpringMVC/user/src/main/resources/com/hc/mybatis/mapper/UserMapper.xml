<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hc.mybatis.mapper.UserMapper">
    <insert id="insert">
        insert into user values (null,#{name},#{sex},#{email})
    </insert>
    <update id="update">
        update user set name = #{name},sex = #{sex},email = #{email} where id = #{id}
    </update>
    <delete id="delete">
        delete from user where id = #{id}
    </delete>


    <select id="selectAll" resultType="com.hc.mybatis.pojo.User">
        select * from user
    </select>
    <select id="selectById" resultType="com.hc.mybatis.pojo.User">
        select * from user where id = #{id}
    </select>
</mapper>