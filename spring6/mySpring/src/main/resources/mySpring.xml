<?xml version="1.0" encoding="UTF-8"?>
<beans>
    <bean id="userBean" class="com.hc.mySpring.bean.User">
        <property name="name" value="张三"/>
        <property name="age" value="18"/>
    </bean>
    <bean id="userDaoBean" class="com.hc.mySpring.bean.UserDao"/>
    <bean id="userServiceBean" class="com.hc.mySpring.bean.UserService">
        <property name="userDao" ref="userDaoBean"/>
    </bean>
</beans>